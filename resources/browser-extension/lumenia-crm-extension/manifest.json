{
  "manifest_version": 3,
  "name": "Lumenia CRM - LinkedIn Import",
  "version": "1.0.0",
  "description": "Import a LinkedIn profile into Lumenia CRM as a lead and draft an outreach message using your workspace's configured AI provider. One click, one profile at a time, nothing automatic.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://lumeniacrm.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*", "https://linkedin.com/in/*"],
      "js": ["content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lumenia CRM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
