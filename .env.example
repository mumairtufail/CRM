APP_NAME=LumeniaCRM
VITE_APP_NAME=LumeniaCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Multi-tenant SaaS: the bare host the app is served from. Any subdomain of this
# is treated as a tenant workspace (e.g. acme.crm.test). Leave blank to disable
# subdomain resolution and rely solely on the logged-in user's organization.
# For local dev with subdomains, modern browsers route *.localhost automatically:
#   APP_DOMAIN=localhost  and visit  acme.localhost:8000
APP_DOMAIN=

# Google OAuth (Sign in / Sign up with Google). Create a Web OAuth Client ID in
# Google Cloud Console and set the authorized redirect URI to match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to a leading-dot domain to share the session across tenant subdomains,
# e.g. SESSION_DOMAIN=.localhost  (only needed when using subdomain tenancy).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Twilio (stored per org in DB; these are fallback defaults)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Kimi K2 via NVIDIA NIM (for WhatsApp AI bot)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k2

# Paddle (pricing page checkout). PADDLE_ENVIRONMENT must be "sandbox" or
# "production" — the app refuses to render checkout if it's unset, so it can
# never accidentally run against the wrong Paddle account.
PADDLE_ENVIRONMENT=sandbox
# Server-side only — never exposed to the frontend. From Paddle > Developer tools > Authentication.
PADDLE_API_KEY=
# Client-side token, safe to expose to the browser. From Paddle > Developer tools > Authentication.
# Sandbox tokens are prefixed "test_"; live tokens are prefixed "live_".
PADDLE_CLIENT_KEY=
# Signing secret for the notification destination that receives fulfillment
# webhooks (subscription.*/customer.*/transaction.completed). From Paddle >
# Developer tools > Notifications > (your destination) > "endpoint secret key".
# Server-side only — never exposed to the frontend.
PADDLE_WEBHOOK_SECRET=
